<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="System.Management" Version="10.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- WPF SDK が自動で ApplicationDefinition にするのはルート直下の App.xaml だけなので、src\ に移した App.xaml を明示する。
       明示しないと普通の Page 扱いになり、Main メソッドが生成されない（CS5001） -->
  <ItemGroup>
    <Page Remove="src\App.xaml" />
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <FrontendDir>$(MSBuildProjectDirectory)\frontend\</FrontendDir>
    <!-- csproj はフォルダ内のファイルを自動で取り込むので、C# と関係ないフォルダは対象外にする（node_modules を走査するとビルドが遅くなる） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);frontend\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- dotnet publish の途中でフロントエンドをビルドし、dist の中身を publish 先の wwwroot に含める -->
  <Target Name="PublishFrontend" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm install" WorkingDirectory="$(FrontendDir)" Condition="!Exists('$(FrontendDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" />
    <!-- 前回のビルドで作られた古いファイル（ハッシュ付きのJS/CSS）が残らないように消しておく -->
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendDir)dist\**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles->'%(FullPath)')">
        <RelativePath>wwwroot\%(FrontendDistFiles.RecursiveDir)%(FrontendDistFiles.Filename)%(FrontendDistFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <!-- PublishSingleFile で exe に埋め込まれると WebView2 がファイルとして読めないので、外に置く -->
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
